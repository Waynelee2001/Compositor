  "Sign in with ChatGPT":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 ChatGPT 登录"}}}},
  "Cancel sign-in":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"取消登录"}}}},
  "Use an API key":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 API 密钥"}}}},
  "API key":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"API 密钥"}}}},
