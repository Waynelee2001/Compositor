{
 "sourceLanguage":"en",
 "strings":{
  "Stopping":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"正在停止"}}}},
  "Awaiting approval":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"等待确认"}}}},
  "Working":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"处理中"}}}},
  "Connecting":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"正在连接"}}}},
  "Connected":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已连接"}}}},
  "Disconnected":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"未连接"}}}},
  "Describe the photo edit…":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"描述你想怎样修这张照片…"}}}},
  "Share the canvas with the model?":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"允许模型查看画布吗？"}}}},
  "Cancel":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"取消"}}}},
  "Allow canvas sharing":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"允许共享画布"}}}},
  "Codex may send a 1024px preview of this document to the signed-in model provider. Original image metadata and the .comp package are not attached. Turn this off at any time.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 可以将此文档的最长边不超过 1024 像素的预览发送给已登录的模型服务。不会附带原图元数据或 .comp 工程。你可以随时关闭此选项。"}}}},
  "AI Assistant":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"AI 助手"}}}},
  "New conversation":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"新建对话"}}}},
  "AI settings":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"AI 设置"}}}},
  "Edit photos through conversation":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"通过对话完成修图"}}}},
  "Connect Codex, sign in, and describe the change. Edits run through the editor and can be undone.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"连接 Codex、登录账号，然后描述你的修改要求。所有修图操作通过编辑器执行，可以撤销。"}}}},
  "Connect Codex":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"连接 Codex"}}}},
  "Make the photo clearer without harsh skin texture.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"让照片更通透，但不要让肤质显得生硬。"}}}},
  "Give it a warm cinematic look.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"调成温暖的电影感。"}}}},
  "Undo the last edit.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"撤销上一次修改。"}}}},
  "Share canvas preview":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"共享画布预览"}}}},
  "Confirm each image edit":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"每次修改图片前确认"}}}},
  "Approve this edit?":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"允许这次修改吗？"}}}},
  "Decline":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"拒绝"}}}},
  "Apply edit":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"应用修改"}}}},
  "Answer":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"回答"}}}},
  "Choose an answer":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"选择答案"}}}},
  "Submit answers":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"提交回答"}}}},
  "Codex connection":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 连接"}}}},
