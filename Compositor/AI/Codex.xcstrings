  "Result":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"结果"}}}},
  "running":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"执行中"}}}},
  "awaitingApproval":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"等待确认"}}}},
  "completed":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已完成"}}}},
  "failed":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"失败"}}}},
  "denied":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已拒绝"}}}},
  "interrupted":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已停止"}}}},
  "Codex path (automatic when empty)":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 路径（留空自动查找）"}}}},
  "Choose Codex executable…":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"选择 Codex 可执行文件…"}}}},
  "Choose the installed Codex executable.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择已安装的 Codex 可执行文件。"}}}},
  "Changes take effect on reconnect. No terminal session is needed while using the editor.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"重新连接后应用路径更改。使用编辑器时无需另开终端。"}}}},
  "General":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"通用"}}}},
  "Codex":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex"}}}},
  "Use the AI sidebar settings to connect, sign in, and choose a model.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请在 AI 侧栏设置中连接、登录并选择模型。"}}}},
  "Use the Codex-enabled build to launch the local agent. The standard build keeps Apple's App Sandbox enabled.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请使用 Compositor-Codex 构建启动本地 Agent。标准构建保留了 Apple 应用沙盒，不能直接启动外部 Codex。"}}}},
  "Codex is still connecting.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 正在连接。"}}}},
  "Codex executable not found. Set its path in AI settings.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"找不到 Codex 可执行文件。请在 AI 设置中指定其路径。"}}}},
  "Codex returned an unexpected sign-in address.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 返回了非预期的登录地址，已阻止打开。"}}}},
  "Codex did not return a sign-in address.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 没有返回登录地址。"}}}},
  "Could not open the sign-in browser.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"无法打开登录浏览器。"}}}},
  "Enter an API key.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入 API 密钥。"}}}},
  "Sign in to Codex before sending a message.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请先登录 Codex，再发送消息。"}}}},
  "Codex did not return a thread ID.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 没有返回会话 ID。"}}}},
  "Codex did not return a turn ID.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 没有返回轮次 ID。"}}}},
  "Non-editor execution was blocked.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已阻止编辑器之外的执行操作。"}}}},
  "Sign-in failed.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"登录失败。"}}}},
  "Codex attempted a non-editor action. The turn was interrupted.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 尝试执行非编辑器操作，本轮已停止。"}}}},
  "Codex reported an error.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 返回了错误。"}}}},
  "The Codex turn failed.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"本轮 Codex 执行失败。"}}}},
  "Edit declined.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已拒绝修改。"}}}},
  "No matching document for this tool call.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"此工具调用没有匹配的文档。"}}}},
  "Conflicting duplicate tool call.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"检测到参数冲突的重复工具调用。"}}}},
  "Tool-call limit reached. Start a new turn.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已达到本轮工具调用上限，请开始新一轮。"}}}},
  "Unsupported editor tool or arguments.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"不支持的编辑工具或参数。"}}}},
  "Camera Raw requires a layer ID and supported numeric parameters.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Camera Raw 需要图层 ID 和支持的数值参数。"}}}},
  "This editor tool does not accept arguments.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"此编辑工具不接受参数。"}}}},
  "The document changed. Start a new turn for the current document.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"文档已更换，请针对当前文档开始新一轮对话。"}}}},
  "Finish the current editor operation before running an AI tool.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请先完成当前编辑操作，再运行 AI 工具。"}}}},
  "Canvas sharing is off. Ask the user to enable it.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"画布共享已关闭，请先启用共享。"}}}},
  "This canvas is too large for an AI preview. Use a smaller canvas.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"此画布过大，无法生成 AI 预览，请使用较小的画布。"}}}},
  "Could not create a canvas preview.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"无法生成画布预览。"}}}},
  "The editor is not ready for an AI edit.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑器当前无法执行 AI 修改。"}}}},
  "The active layer changed. Read document info again before editing.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"当前图层已更换，请重新读取文档信息后再修改。"}}}},
  "Camera Raw did not commit. Check or cancel the editor's filter dialog.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Camera Raw 未提交，请检查或取消编辑器中的滤镜对话框。"}}}},
  "Camera Raw adjustment applied. The edit can be undone in Compositor.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已应用 Camera Raw 调整，可在 Compositor 中撤销。"}}}},
  "Nothing to undo.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"没有可以撤销的操作。"}}}},
  "Nothing to redo.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"没有可以重做的操作。"}}}},
  "Undo complete.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已撤销。"}}}},
  "Redo complete.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已重做。"}}}},
  "Canvas preview sent (1024px maximum).":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已发送画布预览（最长边 1024 像素）。"}}}},
  "Codex frame is too large.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 消息帧过大。"}}}},
  "Invalid Codex RPC envelope.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex RPC 消息格式无效。"}}}},
  "Codex disconnected during a JSON frame.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 在消息传输完成前断开了连接。"}}}},
  "Codex disconnected. Reconnect to continue.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 已断开，请重新连接后继续。"}}}},
  "Codex is not connected.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 尚未连接。"}}}},
  "Codex RPC failed.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex RPC 请求失败。"}}}},
  "Codex disconnected.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 已断开。"}}}},
  "Conversation is too large to save locally.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"对话过大，无法继续保存到本地。"}}}},
  "Model profiles":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"模型配置"}}}},
  "Done":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"完成"}}}},
  "Profile":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"配置"}}}},
  "Service":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"服务"}}}},
  "Add service":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"添加服务"}}}},
  "New custom service":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"新建自定义服务"}}}},
  "Custom service":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"自定义服务"}}}},
  "Save and use":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"保存并使用"}}}},
  "Remove profile":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"删除配置"}}}},
  "Remove":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"删除"}}}},
  "Profile name":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"配置名称"}}}},
  "Base URL (include a port for local services)":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"服务地址（本地服务可包含端口）"}}}},
  "API key (leave blank to keep the saved key)":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"API Key（留空保留已存密钥）"}}}},
  "Model ID":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"模型 ID"}}}},
  "Choose model":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"选择模型"}}}},
  "Test connection / load models":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"测试连接 / 获取模型"}}}},
  "DeepSeek preset":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"DeepSeek 预设"}}}},
  "DeepSeek V4.1 Flash uses deepseek-flash and supports image input.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"DeepSeek V4.1 Flash 的模型 ID 为 deepseek-flash，支持图片输入。"}}}},
  "This model supports image input":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"此模型支持图片输入"}}}},
  "Requires the Responses API with function calling. Chat Completions-only services are not compatible. Model-list checks do not run inference.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"需要支持 Responses API 和工具调用；仅支持 Chat Completions 的服务不兼容。获取模型列表不会调用模型推理。"}}}},
  "API keys stay in macOS Keychain. They are not written to the project, CLI config, or chat history.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"API Key 保存在 macOS 钥匙串中，不写入项目、CLI 配置或聊天记录。"}}}},
  "Switching services keeps separate histories and turns canvas sharing off. It does not transfer old chats or photos.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"切换服务会使用独立会话并关闭画布共享，不会转发旧聊天或图片。"}}}},
  "Remove this profile and its API key?":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"删除此配置及其 API Key？"}}}},
  "Local conversation files are kept. This does not delete anything from the model service.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"本地会话文件会保留，不会删除模型服务中的任何内容。"}}}},
  "ChatGPT / Codex uses the existing browser or OpenAI API-key sign-in. Your usual CLI configuration is unchanged.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"ChatGPT / Codex 继续使用现有的浏览器登录或 OpenAI API Key 登录，不修改你的日常 CLI 配置。"}}}},
  "Model list loaded. This verifies the catalog endpoint, not a paid inference request.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已获取模型列表。这只验证列表接口，不代表付费推理请求已通过。"}}}},
  "Enter a profile name (up to 80 characters).":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入配置名称，最多 80 个字符。"}}}},
  "Enter a model ID without spaces.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入不含空白字符的模型 ID。"}}}},
  "Enter a base URL without credentials, query parameters, or fragments.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入服务基础地址，不要在地址中包含密钥、查询参数或片段标识。"}}}},
  "Use HTTPS for remote services. HTTP is allowed only for localhost.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"远程服务请使用 HTTPS。只有本地回环地址允许使用 HTTP。"}}}},
  "This integration requires a Responses API endpoint, not Chat Completions or Messages.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"此接入需要 Responses API，不是 Chat Completions 或 Messages 接口。"}}}},
  "Invalid service address.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"服务地址无效。"}}}},
  "Could not read the API key from macOS Keychain.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"无法从 macOS 钥匙串读取 API Key。"}}}},
  "Enter an API key without control characters.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"API Key 不能包含控制字符或内嵌换行。"}}}},
  "Could not save the API key in macOS Keychain.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"无法将 API Key 保存到 macOS 钥匙串。"}}}},
  "Could not remove the API key from macOS Keychain.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"无法从 macOS 钥匙串删除 API Key。"}}}},
  "Enter an API key. Changing the service address requires a new key.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入 API Key。修改服务地址后需要重新填写密钥。"}}}},
  "Invalid model-list response.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"模型列表响应格式无效。"}}}},
  "The service rejected the API key or account permissions.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"服务拒绝了 API Key，或账号没有相应权限。"}}}},
  "This service has no model-list endpoint. Enter the model ID manually; Responses API support is still required.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"该服务未提供模型列表接口。可以手动填写模型 ID，但服务仍须支持 Responses API。"}}}},
  "The model-list response is too large.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"模型列表响应过大。"}}}},
  "The service returned no models. Enter a model ID manually.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"服务未返回模型，请手动填写模型 ID。"}}}},
  "Add this service's API key in Model profiles.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请在“模型配置”中填写该服务的 API Key。"}}}},
  "Use Model profiles to set this service's API key.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"请通过“模型配置”设置该服务的 API Key。"}}}},
  "Could not prepare the Codex connection.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"无法准备 Codex 通信连接。"}}}},
  "Edit service and model…":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑服务和模型…"}}}},
  "Connected means the local Codex process is ready. Test the API key in Model profiles.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"“已连接”表示本地 Codex 进程就绪。API Key 可在“模型配置”中测试。"}}}},
  "Image input is disabled for this model.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"此模型未启用图片输入。"}}}},
  "Choose a service, connect, and describe the change. Configure DeepSeek or another provider in Model profiles. Edits can be undone.":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"选择服务并连接，然后描述修改要求。DeepSeek 或其他服务可在“模型配置”中设置，修图操作可以撤销。"}}}},
  "Appearance":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"外观主题"}}}},
  "Follow System":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"跟随系统"}}}},
  "Light appearance":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"浅色"}}}},
  "Dark appearance":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"深色"}}}},
  "AI service":{"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"AI 服务"}}}}
 },
