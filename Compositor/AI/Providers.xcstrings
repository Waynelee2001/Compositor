{
  "sourceLanguage": "en",
  "strings": {
    "Provider": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商"
          }
        }
      }
    },
    "Models and API providers": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型与 API 配置"
          }
        }
      }
    },
    "Configuration": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置"
          }
        }
      }
    },
    "Add DeepSeek": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 DeepSeek"
          }
        }
      }
    },
    "Add custom API": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加自定义 API"
          }
        }
      }
    },
    "Codex / ChatGPT keeps its existing account login. Use the account controls below.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex / ChatGPT 保留原有账号登录方式，可使用下方账号控件登录。"
          }
        }
      }
    },
    "Use this provider": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此配置"
          }
        }
      }
    },
    "Name": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "Base URL (include port when needed)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 地址（可包含端口）"
          }
        }
      }
    },
    "API key": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥"
          }
        }
      }
    },
    "API key (blank keeps the saved key)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥（留空保留已保存的密钥）"
          }
        }
      }
    },
    "Model ID": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型名称 / ID"
          }
        }
      }
    },
    "Choose model": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择模型"
          }
        }
      }
    },
    "This model supports image input": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型支持图片输入"
          }
        }
      }
    },
    "Fetch models": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取模型列表"
          }
        }
      }
    },
    "Delete": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Save and use": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存并使用"
          }
        }
      }
    },
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Responses-compatible APIs only. Fetching the model list does not run paid inference. A manually entered model ID also works.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接口需兼容 Responses API。获取模型列表不会发起付费推理，也可直接手动填写模型 ID。"
          }
        }
      }
    },
    "Keys are stored in macOS Keychain. Changing the API address requires entering the key again. Switching providers does not transfer previous chat or images.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥保存在 macOS 钥匙串。修改接口地址后需要重新输入密钥；切换服务商不会转发之前的对话和图片。"
          }
        }
      }
    },
    "Delete this provider and its saved API key?": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此配置及其保存的 API 密钥？"
          }
        }
      }
    },
    "Provider selected. Connect or send a message to start.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择该配置。点击连接或发送消息即可开始。"
          }
        }
      }
    },
    "Enter the API key again when changing the API address.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改 API 地址后，请重新输入该接口的密钥。"
          }
        }
      }
    },
    "Model list loaded. Save and use this configuration to start chatting.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已获取模型列表，保存并使用该配置后即可开始对话。"
          }
        }
      }
    },
    "Enter a DeepSeek API key in provider settings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在服务商设置中填写 DeepSeek API 密钥。"
          }
        }
      }
    },
    "Enter an API base URL without credentials, query parameters, or fragments.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 API 基础地址，不要在地址中包含账号、密码、查询参数或片段。"
          }
        }
      }
    },
    "Use HTTPS, or HTTP only for localhost/127.0.0.1/::1.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 HTTPS；仅 localhost、127.0.0.1 或 ::1 本机接口可使用 HTTP。"
          }
        }
      }
    },
    "Codex needs a Responses API endpoint, not a Chat Completions endpoint.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 需要 Responses API 接口，不能直接使用 Chat Completions 接口。"
          }
        }
      }
    },
    "Invalid API address.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 地址无效。"
          }
        }
      }
    },
    "Enter a provider name and a valid model ID.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写配置名称和有效的模型 ID。"
          }
        }
      }
    },
    "Could not read the API key from Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从钥匙串读取 API 密钥。"
          }
        }
      }
    },
    "Could not save the API key to Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将 API 密钥保存到钥匙串。"
          }
        }
      }
    },
    "Could not remove the API key from Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从钥匙串移除 API 密钥。"
          }
        }
      }
    },
    "Model list request failed (HTTP %@). Check the address and API key; manual model IDs are also supported.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取模型列表失败（HTTP %@）。请检查接口地址和密钥，也可手动填写模型 ID。"
          }
        }
      }
    },
    "The model list response is too large.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型列表响应过大。"
          }
        }
      }
    },
    "The endpoint did not return a compatible model list. Enter the model ID manually.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接口未返回兼容的模型列表，请手动填写模型 ID。"
          }
        }
      }
    },
    "No models were returned. Enter the model ID manually.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接口没有返回模型，请手动填写模型 ID。"
          }
        }
      }
    },
    "Stop the current turn before changing models or providers.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先停止当前任务，再切换模型或服务商。"
          }
        }
      }
    },
    "Use API provider settings for this connection.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接请使用 API 服务商设置。"
          }
        }
      }
    },
    "This provider is configured as text-only. Choose an image-capable model to inspect the canvas.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置仅支持文本，请切换到支持图片输入的模型后再查看画布。"
          }
        }
      }
    },
    "Appearance": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观主题"
          }
        }
      }
    },
    "Light": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浅色"
          }
        }
      }
    },
    "Dark": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色"
          }
        }
      }
    },
    "Follow System": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      }
    }
  },
  "version": "1.0"
}
