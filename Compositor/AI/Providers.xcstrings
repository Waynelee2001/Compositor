{
  "sourceLanguage": "en",
  "strings": {
    "Provider": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商"
          }
        }
      }
    },
    "Add provider": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加服务商"
          }
        }
      }
    },
    "Edit provider": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑服务商"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Provider settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商设置"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "Custom provider": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义服务商"
          }
        }
      }
    },
    "API base URL (including port if needed)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 地址（需要时包含端口）"
          }
        }
      }
    },
    "API key (leave empty to keep saved key)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥（留空保留已存密钥）"
          }
        }
      }
    },
    "Model ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型 ID"
          }
        }
      }
    },
    "Available models": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选模型"
          }
        }
      }
    },
    "This model supports image input": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该模型支持图片输入"
          }
        }
      }
    },
    "Responses API compatible services only. DeepSeek V4.1 Flash uses deepseek-flash. For a proxy, include its /v1 path when required.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持兼容 Responses API 的服务。DeepSeek V4.1 Flash 使用 deepseek-flash。中转服务需要时请在地址中包含 /v1。"
          }
        }
      }
    },
    "Fetch models": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取模型"
          }
        }
      }
    },
    "Test model…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试模型…"
          }
        }
      }
    },
    "Save and select": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存并选用"
          }
        }
      }
    },
    "Delete saved key…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除已存密钥…"
          }
        }
      }
    },
    "Test this model?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试这个模型？"
          }
        }
      }
    },
    "Run test": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始测试"
          }
        }
      }
    },
    "This sends a short test prompt to the entered address and may incur a small API charge. No photo or conversation is included.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将向所填地址发送简短测试，可能产生少量 API 费用，不附带照片或聊天记录。"
          }
        }
      }
    },
    "Keys stay in macOS Keychain. Switching provider or model opens its separate conversation and turns canvas sharing off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥保存在 macOS 钥匙串。切换服务商或模型会进入各自独立的会话，并关闭画布共享。"
          }
        }
      }
    },
    "Model list loaded. Choose a model or enter its ID manually.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型列表已读取，可选择模型或手动填写模型 ID。"
          }
        }
      }
    },
    "The Responses API test completed. Image quality and editor tool use still need a real conversation test.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Responses API 测试已完成。修图质量和编辑器工具调用仍需在真实对话中验证。"
          }
        }
      }
    },
    "Delete this provider's saved key?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此服务商已保存的密钥？"
          }
        }
      }
    },
    "Saved key deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除保存的密钥。"
          }
        }
      }
    },
    "This provider uses its saved API key, not your ChatGPT login.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该服务商使用单独保存的 API 密钥，不使用 ChatGPT 登录。"
          }
        }
      }
    },
    "Advanced connection settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级连接设置"
          }
        }
      }
    },
    "A 1024px preview may be sent to the selected provider. Original image metadata and the .comp package are not attached. Turn sharing off at any time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可向当前选择的服务商发送最长边 1024 像素的预览，不附带原图元数据或 .comp 工程。可随时关闭共享。"
          }
        }
      }
    },
    "Use an HTTPS base URL, or HTTP on localhost, without credentials or query parameters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写 HTTPS 地址或 localhost 的 HTTP 地址，不要在地址中放密钥或查询参数。"
          }
        }
      }
    },
    "This integration needs a Responses API endpoint, not a Chat Completions-only endpoint.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此接入需要 Responses API，不支持仅提供 Chat Completions 的接口。"
          }
        }
      }
    },
    "Invalid API base URL.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 地址无效。"
          }
        }
      }
    },
    "Enter a provider name.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写服务商名称。"
          }
        }
      }
    },
    "Enter a model ID (up to 128 bytes, without spaces).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写模型 ID（最多 128 字节，不含空格）。"
          }
        }
      }
    },
    "Save at most 100 model IDs per provider.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个服务商最多保存 100 个模型 ID。"
          }
        }
      }
    },
    "Could not read the API key from Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从钥匙串读取 API 密钥。"
          }
        }
      }
    },
    "Enter a valid API key without line breaks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写有效的 API 密钥，不要包含换行。"
          }
        }
      }
    },
    "Could not save the API key in Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将 API 密钥保存到钥匙串。"
          }
        }
      }
    },
    "Could not remove the API key from Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从钥匙串删除 API 密钥。"
          }
        }
      }
    },
    "No model IDs were returned. Enter a model ID manually.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接口没有返回模型 ID，请手动填写。"
          }
        }
      }
    },
    "The endpoint responded but did not complete the test. Check model and Responses API compatibility.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接口有响应，但未完成测试。请检查模型和 Responses API 兼容性。"
          }
        }
      }
    },
    "Invalid API response.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 响应无效。"
          }
        }
      }
    },
    "API authentication failed. Check the key and model permissions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 鉴权失败，请检查密钥和模型权限。"
          }
        }
      }
    },
    "API route not found. Check the base URL and Responses API support.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 API 路径，请检查地址及 Responses API 支持。"
          }
        }
      }
    },
    "API rate limit or account quota reached.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 已达到速率或额度限制。"
          }
        }
      }
    },
    "API redirects are blocked to protect your key. Enter the final base URL.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为保护密钥已阻止重定向，请直接填写最终 API 地址。"
          }
        }
      }
    },
    "The provider returned a server error. Try again later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商返回服务器错误，请稍后重试。"
          }
        }
      }
    },
    "The provider response is too large.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商响应过大。"
          }
        }
      }
    },
    "Could not reach the API. Check the address, port, network, and certificate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 API，请检查地址、端口、网络和证书。"
          }
        }
      }
    },
    "Save an API key for this provider in AI settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 AI 设置中为此服务商保存 API 密钥。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
