{
  "sourceLanguage": "en",
  "strings": {
    "AI Assistant": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 助手"
          }
        }
      }
    },
    "Describe the edit you want. AI tools are ready; connect a model provider to enable conversations.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述你想要的修改。AI 工具已就绪；连接模型服务后即可开始对话。"
          }
        }
      }
    },
