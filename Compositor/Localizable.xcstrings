    "New color": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新颜色"
          }
        }
      }
    },
    "Click the image to pick the color to select.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击图像选择要选取的颜色。"
          }
