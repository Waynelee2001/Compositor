          "stringUnit": {
            "state": "translated",
            "value": "选择自定义网格颜色"
          }
        }
      }
    },
    "Apply outside this range instead": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改为作用于该范围之外"
          }
        }
      }
    },
    "Targeted adjustment: drag on the image to change that color's saturation, or its hue with Command held": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标调整：在图像上拖动可改变该颜色的饱和度；按住 Command 拖动可改变色相"
