    "Delete Guide": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除参考线"
          }
        }
      }
    },
    "Add layer mask revealing the selection (Option-click to hide it)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加显示选区的图层蒙版（按住 Option 单击可隐藏选区）"
          }
        }
      }
    },
    "Add layer mask (Option-click for a black mask)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加图层蒙版（按住 Option 单击可创建黑色蒙版）"
          }
        }
      }
    },
    "Link layer and mask so they move together": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接图层和蒙版，使其一起移动"
          }
        }
      }
    },
    "Unlink layer and mask to move or transform them separately": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消图层与蒙版链接，以便分别移动或变换"
          }
        }
      }
    },
    "Show the image again (or Option-click the mask thumbnail)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新显示图像（或按住 Option 单击蒙版缩略图）"
          }
        }
      }
    },
    "Click to select; double-click to edit; Option-drag to copy ": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击选择；双击编辑；按住 Option 拖动可复制 "
          }
        }
      }
    },
    "effect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "效果"
          }
        }
      }
    },
    " color": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 颜色"
          }
        }
      }
    },
    "Blend mode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "混合模式"
          }
        }
      }
    },
    "Opacity": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明度"
          }
        }
      }
    },
    "Press M to switch between Rectangle and Ellipse": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 M 在矩形和椭圆之间切换"
          }
        }
      }
    },
    "Press Tab to switch between Wand and Object": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Tab 在魔棒和对象之间切换"
          }
        }
      }
    },
    "Press L to switch between Freehand and Polygonal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 L 在自由套索和多边形套索之间切换"
          }
        }
      }
    },
    "Hold Shift to add or Option to subtract for one outline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 添加选区，按住 Option 减去选区"
          }
        }
      }
    },
    "Smooth selection edges; turn off for hard pixel edges": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑选区边缘；关闭后得到硬边像素选区"
          }
        }
      }
    },
    "Smooth the detected object outline; turn off for the raw pixel mask": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑检测到的对象轮廓；关闭后使用原始像素蒙版"
          }
        }
      }
    },
    "Fade the edge of the selection by this many pixels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按指定像素数柔化选区边缘"
          }
        }
      }
    },
    "How far each color channel (0–255) can differ from the clicked color and still be selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个颜色通道与点击颜色允许相差的范围（0–255）"
          }
        }
      }
    },
    "Match the clicked pixel, or the average of the pixels around it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配点击像素，或匹配其周围像素的平均值"
          }
        }
      }
    },
    "Read colors from the active layer only, or from every visible layer as shown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅从当前图层读取颜色，或从所有可见图层的合成结果读取"
          }
        }
      }
    },
    "Select only similar pixels connected to the one you click; off selects them everywhere": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅选择与点击位置相连的相似像素；关闭后会选择所有位置的相似像素"
          }
        }
      }
    },
    "Brightens or darkens the whole picture, in stops of light. Hold Option to see clipped highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按曝光档位整体提亮或压暗画面。按住 Option 可查看高光溢出。"
          }
        }
      }
    },
    "Makes light and dark tones more or less different, mostly around the middle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱明暗差异，主要作用于中间调。"
          }
        }
      }
    },
    "Adjusts the bright parts of the picture. Hold Option to see clipped highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整画面亮部。按住 Option 可查看高光溢出。"
          }
        }
      }
    },
    "Adjusts the dark parts of the picture. Hold Option to see clipped shadows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整画面暗部。按住 Option 可查看阴影溢出。"
          }
        }
      }
    },
    "Sets the brightest point. Hold Option to see clipped highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置最亮点。按住 Option 可查看高光溢出。"
          }
        }
      }
    },
    "Sets the darkest point. Hold Option to see clipped shadows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置最暗点。按住 Option 可查看阴影溢出。"
          }
        }
      }
    },
    "Auto balances the average color. Custom follows Temperature and Tint.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动模式根据画面平均颜色校正；自定义模式使用色温和色调。"
          }
        }
      }
    },
    "Click a pixel that should be neutral.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击一个应当呈中性的像素。"
          }
        }
      }
    },
    "Click the original layer. Click the eyedropper again to stop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在原始图层上点击取样；再次点击吸管可结束。"
          }
        }
      }
    },
    "Shifts the picture from blue to yellow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在蓝色与黄色之间调整画面色温。"
          }
        }
      }
    },
    "Shifts the picture from green to mauve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在绿色与洋红之间调整色调。"
          }
        }
      }
    },
    "Strengthens quiet colors more than colors that are already strong, and protects skin tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先增强低饱和颜色，同时尽量保护肤色。"
          }
        }
      }
    },
    "Strengthens or weakens every color by the same amount.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统一增强或减弱所有颜色的饱和度。"
          }
        }
      }
    },
    "Adds or softens small detail.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或柔化细小纹理。"
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或柔化较大结构的局部对比。"
          }
        }
      }
    },
    "Clears haze when raised, and adds haze when lowered.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提高时去除朦胧，降低时增加雾感。"
          }
        }
      }
    },
    "Spreads a glow from the bright areas.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从亮部向外扩散辉光。"
          }
        }
      }
    },
    "Diffusion is soft and wide, Bloom is tighter, and Halation is a red fringe.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩散柔和且范围更大；绽放更紧凑；光晕会产生偏红边缘。"
          }
        }
      }
    },
    "Chooses how bright an area must be to glow. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定多亮的区域才产生辉光；辉光为 0 时无效果。"
          }
        }
      }
    },
    "Sets how far the glow reaches. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置辉光扩散距离；辉光为 0 时无效果。"
          }
        }
      }
    },
    "Shifts the glow from cool to warm. Halation stays red. Has no effect until Glow is raised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在冷暖之间调整辉光；光晕模式保持偏红；辉光为 0 时无效果。"
          }
        }
      }
    },
    "Darkens or lightens the edges. The center does not change.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压暗或提亮画面边缘，中心区域不变。"
          }
        }
      }
    },
    "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光优先会保护亮部边缘；颜色优先还会降低边缘色彩；绘制叠加会均匀覆盖边缘。"
          }
        }
      }
    },
    "Sets where the vignette begins, from the center outward.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置暗角从中心向外开始的位置。"
          }
        }
      }
    },
    "Makes the vignette rounder or more square.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让暗角更圆或更接近方形。"
          }
        }
      }
    },
    "Softens the edge of the vignette.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔化暗角边缘。"
          }
        }
      }
    },
    "Protects bright pixels while a dark vignette is applied. Used by Highlight Priority.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用暗角时保护亮部像素，仅用于高光优先模式。"
          }
        }
      }
    },
    "Adds film grain, strongest in the middle tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒，中间调最明显。"
          }
        }
      }
    },
    "Makes the grain coarser or finer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整颗粒粗细。"
          }
        }
      }
    },
    "Makes the grain smoother or more uneven.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整颗粒平滑度与不规则程度。"
          }
        }
      }
    },
    "Click a color in the picture. Nearby color families move together.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击画面中的颜色，相邻色系会一起调整。"
          }
        }
      }
    },
    "Click the picture to save a color. Up to eight colors.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击画面保存颜色，最多可保存 8 个。"
          }
        }
      }
    },
    "HSL lists every color. Color edits one family. Point Color adjusts a color you pick.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL 可分别调整各色系；颜色模式编辑一个色系；点颜色用于调整你取样的颜色。"
          }
        }
      }
    },
    "Hue shifts the color, Saturation its strength, and Luminance its brightness.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相改变颜色位置，饱和度改变颜色强度，明度改变亮度。"
          }
        }
      }
    },
    "Drag inside the wheel. Angle sets hue, distance sets saturation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在色轮内拖动：角度决定色相，距离决定饱和度。"
          }
        }
      }
    },
    "Three-Way shows shadows, midtones, and highlights. The other choices show one wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三向模式同时显示阴影、中间调和高光；其他模式只显示一个色轮。"
          }
        }
      }
    },
    "Controls how much the three tonal wheels overlap.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制三个色调色轮之间的重叠程度。"
          }
        }
      }
    },
    "Shifts the wheels toward shadows or highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将色轮影响范围偏向阴影或高光。"
          }
        }
      }
    },
    "How strong the sharpening is.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制锐化强度。"
          }
        }
      }
    },
    "How far from each edge the sharpening reaches, in pixels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制锐化作用到边缘周围的像素范围。"
          }
        }
      }
    },
    "Limits sharpening to stronger edges. Hold Option to see the mask.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在更明显的边缘应用锐化。按住 Option 可查看蒙版。"
          }
        }
      }
    },
    "Smooths grain and noise in brightness.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少亮度通道中的颗粒和噪点。"
          }
        }
      }
    },
    "Preserves fine texture while luminance noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降低亮度噪点时保留细小纹理。"
          }
        }
      }
    },
    "Smooths colored speckles.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少彩色噪点。"
          }
        }
      }
    },
    "Preserves colored edges while color noise is reduced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降低彩色噪点时保留彩色边缘。"
          }
        }
      }
    },
    "Pulls red and blue fringes apart toward the center to reduce color edging.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校正红蓝边缘偏移以减少色差。"
          }
        }
      }
    },
    "Brightens or darkens the corners to counter lens falloff.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗角落，以补偿镜头暗角。"
          }
        }
      }
    },
    "Straightens barrel or pincushion bending.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校正桶形或枕形畸变。"
          }
        }
      }
    },
    "Moves the picture up or down.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下移动画面。"
          }
        }
      }
    },
    "Moves the picture left or right.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右移动画面。"
          }
        }
      }
    },
    "Straightens vertical lines toward the center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校正垂直透视线。"
          }
        }
      }
    },
    "Straightens horizontal lines toward the center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校正水平透视线。"
          }
        }
      }
    },
    "Rotates the picture around its center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "围绕画面中心旋转。"
          }
        }
      }
    },
    "Stretches width relative to height.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整宽度相对于高度的比例。"
          }
        }
      }
    },
    "Zooms the transformed picture within the frame.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放变换后的画面以适配边框。"
          }
        }
      }
    },
    "Draw two or more lines on the preview that should be level or vertical.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览上绘制两条或更多应保持水平或垂直的参考线。"
          }
        }
      }
    },
    "Drag on the layer to place a guide. Draw at least two lines.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图层上拖动放置参考线，至少绘制两条。"
          }
        }
      }
    },
    "Click a purple or green fringe to set its hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击紫边或绿边以设置对应的色相范围。"
          }
        }
      }
    },
    "Click the fringe on the layer. Click the eyedropper again to stop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击图层上的色边；再次点击吸管可结束。"
          }
        }
      }
    },
    "Current default. The calibration sliders below apply at full strength.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前默认版本。下面的校准滑块按完整强度生效。"
          }
        }
      }
    },
    "Earliest response. Hue, saturation, and shadow tint move about half as far as Version 6.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最早版本的响应方式。色相、饱和度和阴影色调的变化约为版本 6 的一半。"
          }
        }
      }
    },
    "A little stronger than Version 1. The sliders below still fall well short of the current look.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比版本 1 稍强，但下方滑块的效果仍明显弱于当前版本。"
          }
        }
      }
    },
    "Firmer color than Version 2. Primary shifts stay gentler than the current process.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色变化比版本 2 更明显，但主色调整仍比当前处理方式柔和。"
          }
        }
      }
    },
    "The 2012 response. Calibration reaches most of the strength used by Version 6.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2012 年的响应方式，校准强度已接近版本 6。"
          }
        }
      }
    },
    "Close to the current process, with slightly softer primary and shadow shifts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接近当前处理方式，但主色和阴影调整稍柔和。"
          }
        }
      }
    },
    "Click to add a point. Drag to adjust.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击添加控制点，拖动进行调整。"
          }
        }
      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动控制点；点击添加；双击控制点可删除。"
          }
        }
      }
    },
    "Input and output of the selected curve point.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示所选曲线点的输入值和输出值。"
          }
        }
      }
    },
    "Replaces this curve with a straight line or a contrast curve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将当前曲线重置为直线或对比度曲线。"
          }
        }
      }
    },
    "Color the result while keeping its tones, for a sepia or a cyanotype": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留明暗关系并为结果着色，可用于棕褐色或蓝晒效果"
          }
        }
      }
    },
    "Put each pixel's brightness back afterwards, so only the color moves": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复每个像素原有亮度，仅改变颜色"
          }
        }
      }
    },
    "How far a color may be from the picked ones and still be selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许颜色与取样颜色相差多远仍被选中"
          }
        }
      }
    },
    "Shift-click adds a color, Option-click takes one away.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 单击添加颜色，Option 单击移除颜色。"
          }
        }
      }
    },
    "Click the image to add that color to the selection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击图像，将该颜色加入选区"
          }
        }
      }
    },
    "Click the image to take that color out of the selection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击图像，将该颜色从选区中移除"
          }
        }
      }
    },
    "Click the image to select that color": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击图像以选择该颜色"
          }
        }
      }
    },
    "Select everything except those colors, such as all but a green screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择这些颜色之外的所有内容，例如抠除绿幕颜色"
          }
        }
      }
    },
    "Fill the selection using surrounding pixels from this layer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前图层周围像素填充选区。"
          }
        }
      }
    },
    "Hide the background behind a layer mask, keeping the foreground subjects. The pixels stay, so the background can be painted back at any time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过图层蒙版隐藏背景并保留前景主体。像素不会被删除，可随时通过绘制蒙版恢复背景。"
          }
        }
      }
    },
    "Basic is quick; Advanced refines the mask against the layer's own detail, for hair and fur": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基础模式速度快；高级模式会结合图层细节优化蒙版，更适合头发和毛发"
          }
        }
      }
    },
    "Pull the mask onto the image's own edges, which recovers hair and fur": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将蒙版边缘吸附到图像真实边缘，以恢复头发和毛发细节"
          }
        }
      }
    },
    "Clear the haze that leaves background showing through thin areas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除薄弱区域残留的背景透色"
          }
        }
      }
    },
    "Shrink the mask to drop the rim of background color around the subject, or grow it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收缩蒙版以去除主体边缘的背景色边，或扩展蒙版"
          }
        }
      }
    },
    "Importing images…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在导入图像…"
          }
        }
      }
    },
    "Pixel Grid (800% and above)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像素网格（800% 及以上）"
          }
        }
      }
    },
    "Show Transform Controls": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示变换控件"
          }
        }
      }
    },
    "Curves…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲线…"
          }
        }
      }
    },
    "Levels…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色阶…"
          }
        }
      }
    },
    "Hue/Saturation…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色相/饱和度…"
          }
        }
      }
    },
    "Delete ": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 "
          }
        }
      }
    },
    "New canvas (⌘N)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建画布（⌘N）"
          }
        }
      }
    },
    "Fit canvas in window (⌘0)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使画布适合窗口（⌘0）"
          }
        }
      }
    },
    "Actual pixels (⌘1)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际像素（⌘1）"
          }
        }
      }
    },
    "Zoom in (⌘+)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大（⌘+）"
          }
        }
      }
    },
    "Zoom out (⌘−)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小（⌘−）"
          }
        }
      }
    },
    "sRGB · Transparent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sRGB · 透明"
          }
        }
      }
    },
    "Drag an ellipse · Shift add · Option subtract · Shift again mid-drag circle · Drag inside to move · Delete clears · ⌘D deselect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动绘制椭圆 · Shift 添加 · Option 减去 · 拖动中再次按 Shift 约束为圆形 · 在选区内拖动可移动 · Delete 清除 · ⌘D 取消选择"
          }
        }
      }
    },
    "Drag a rectangle · Shift add · Option subtract · Shift again mid-drag square · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动绘制矩形 · Shift 添加 · Option 减去 · 拖动中再次按 Shift 约束为正方形 · 在选区内拖动可移动 · ⌘拖动移动像素 · Delete 清除 · ⌘D 取消选择"
          }
        }
      }
    },
    "Click an object to select its outline · Tab for Wand · Shift add · Option subtract · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击对象选择其轮廓 · Tab 切换魔棒 · Shift 添加 · Option 减去 · 在选区内拖动可移动 · ⌘拖动移动像素 · Delete 清除 · ⌘D 取消选择"
          }
        }
      }
    },
    "Click to select similar colors · Tab for Object · Shift add · Option subtract · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击选择相似颜色 · Tab 切换对象选择 · Shift 添加 · Option 减去 · 在选区内拖动可移动 · ⌘拖动移动像素 · Delete 清除 · ⌘D 取消选择"
          }
        }
      }
    },
    "Drag to select · Drag inside to move · Shift add · Option subtract · Delete clears · ⌥⌫/⌘⌫ fill · ⌘D deselect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动创建选区 · 在选区内拖动可移动 · Shift 添加 · Option 减去 · Delete 清除 · ⌥⌫/⌘⌫ 填充 · ⌘D 取消选择"
          }
        }
      }
    },
    "Click corners · Click start, double-click or Enter to close · Delete removes corner · Escape cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击添加顶点 · 点击起点、双击或按 Enter 闭合 · Delete 删除顶点 · Escape 取消"
          }
        }
      }
    },
    "Drag to erase": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动擦除"
          }
        }
      }
    },
    "Drag to paint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动绘制"
          }
        }
      }
    },
    " · [ ] size · Shift-[ ] hardness · 1–0 opacity · Escape cancel · Space to pan": {
      "localizations": {
